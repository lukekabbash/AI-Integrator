{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop-default",
  "description": "Minimum capability set for the AI Integrator desktop window.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-confirm",
    "dialog:allow-ask",
    "dialog:allow-message",
    "allow-app-bootstrap",
    "allow-open-external-url",
    "allow-provider-discover",
    "allow-provider-action-list",
    "allow-task-create",
    "allow-task-search-messages",
    "allow-task-set-state",
    "allow-task-update-metadata",
    "allow-task-generate-title",
    "allow-task-update-routing",
    "allow-setting-list",
    "allow-setting-set",
    "allow-local-export",
    "allow-local-clear",
    "allow-storage-totals",
    "allow-usage-summary",
    "allow-voice-typing-credential-status",
    "allow-voice-typing-credential-set",
    "allow-voice-typing-credential-clear",
    "allow-voice-typing-start",
    "allow-voice-typing-append",
    "allow-voice-typing-stop",
    "allow-project-register",
    "allow-project-create",
    "allow-project-list",
    "allow-project-file-list",
    "allow-project-file-read",
    "allow-project-file-rename",
    "allow-project-file-opener-list",
    "allow-project-file-open",
    "allow-project-file-reveal",
    "allow-attachment-preview",
    "allow-git-overview",
    "allow-terminal-open",
    "allow-terminal-run",
    "allow-terminal-interrupt",
    "allow-terminal-close",
    "allow-runtime-action-plan-list",
    "allow-runtime-terminal-open",
    "allow-runtime-terminal-write",
    "allow-runtime-terminal-resize",
    "allow-runtime-terminal-close",
    "allow-git-diff",
    "allow-git-stage",
    "allow-git-unstage",
    "allow-git-commit",
    "allow-git-generate-commit-message",
    "allow-git-push-preview",
    "allow-git-push-confirmed",
    "allow-codex-connect",
    "allow-codex-list-models",
    "allow-codex-start-thread",
    "allow-codex-resume-thread",
    "allow-codex-start-turn",
    "allow-task-snapshot",
    "allow-codex-respond-approval",
