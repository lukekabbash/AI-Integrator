    "allow-acp-connect",
    "allow-acp-start-session",
    "allow-acp-send-turn",
    "allow-acp-set-config-option",
    "allow-acp-set-mode",
    "allow-acp-list-cursor-models",
    "allow-structured-cli-start-turn",
    "allow-delegation-list",
    "allow-delegation-approve",
    "allow-delegation-deny",
    "allow-delegation-send-message",
    "allow-delegation-stop-cmd"
